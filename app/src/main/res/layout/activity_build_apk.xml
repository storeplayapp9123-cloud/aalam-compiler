<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#0D0D0D">

    <!-- LEFT SIDEBAR -->
    <LinearLayout
        android:layout_width="160dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#151515"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AALAM STUDIO"
            android:textColor="#F5A623"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <TextView android:id="@+id/navHome" style="@style/SidebarItem" android:text="Home" />
        <TextView android:id="@+id/navProjects" style="@style/SidebarItem" android:text="Projects" />
        <TextView android:id="@+id/navTools" style="@style/SidebarItem" android:text="Tools" />
        <TextView android:id="@+id/navSettings" style="@style/SidebarItem" android:text="Settings" />
    </LinearLayout>

    <!-- CENTER: BUILD PROGRESS + LOG -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/appNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Finance Hub"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/packageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="com.aalamstudio.financehub • Version 1.0.0"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <FrameLayout
                android:layout_width="100dp"
                android:layout_height="100dp">

                <com.aalam.studio.CircularProgressView
                    android:id="@+id/circularProgress"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/percentText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="0%"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Building APK..."
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/subStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Compiling resources and optimizing your app"
                    android:textColor="#888888"
                    android:textSize="12sp" />

                <ProgressBar
                    android:id="@+id/linearProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:progressTint="#F5A623"
                    android:max="100" />

                <TextView
                    android:id="@+id/timeRemainingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calculating time..."
                    android:textColor="#888888"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Build Log"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#151515"
            android:padding="8dp">

            <TextView
                android:id="@+id/buildLogText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#4CD964"
                android:textSize="11sp"
                android:fontFamily="monospace" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/cancelBuildBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cancel Build"
                android:textColor="#FF5C5C"
                android:backgroundTint="#1A1A1A" />

            <Button
                android:id="@+id/buildBackgroundBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Build in Background"
                android:textColor="#000000"
                android:backgroundTint="#F5A623" />
        </LinearLayout>
    </LinearLayout>

    <!-- RIGHT: BUILD CONFIGURATION -->
    <LinearLayout
        android:layout_width="180dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#151515"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Build Configuration"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <TextView style="@style/ConfigLabel" android:text="Build Type" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/debugBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Debug"
                android:textSize="11sp"
                android:backgroundTint="#1A1A1A"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/releaseBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Release"
                android:textSize="11sp"
                android:backgroundTint="#F5A623"
                android:textColor="#000000" />
        </LinearLayout>

        <TextView style="@style/ConfigLabel" android:text="Min SDK" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Android 7.0 (API 24)"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:background="#1A1A1A"
            android:padding="8dp"
            android:layout_marginBottom="12dp" />

        <TextView style="@style/ConfigLabel" android:text="Target SDK" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Android 14 (API 34)"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:background="#1A1A1A"
            android:padding="8dp"
            android:layout_marginBottom="12dp" />

        <TextView style="@style/ConfigLabel" android:text="Output" />
        <TextView
            android:id="@+id/outputPathText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="/Aalam Studio/Builds"
            android:textColor="#888888"
            android:textSize="10sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/expectedSizeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Expected Size: -- MB"
            android:textColor="#888888"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
